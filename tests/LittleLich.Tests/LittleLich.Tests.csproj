<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests the Godot-free simulation code (Scripts/Core, Scripts/Content) without the Godot runtime. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>LittleLich.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../littlelich/Scripts/Core/**/*.cs" Link="Game/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../littlelich/Scripts/Content/**/*.cs" Link="Game/Content/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../littlelich/Scripts/Skills/**/*.cs" Link="Game/Skills/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../littlelich/Scripts/Crypt/**/*.cs" Link="Game/Crypt/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../littlelich/Scripts/Gear/**/*.cs" Link="Game/Gear/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../littlelich/Scripts/World/**/*.cs" Link="Game/World/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../littlelich/Data/**/*.json" Link="Data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
</Project>
